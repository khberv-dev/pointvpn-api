PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pointvpn

JWT_SECRET=change-me-to-a-long-random-string

# Multicard (RHMT) payments — https://docs.multicard.uz
# Sandbox: https://dev-mesh.multicard.uz  Production: https://mesh.multicard.uz
RHMT_API_URL=https://dev-mesh.multicard.uz
RHMT_APPLICATION_ID=rhmt_test
RHMT_SECRET=change-me
RHMT_STORE_ID=6
# Public URL of POST /payment/handle on this API
RHMT_CALLBACK_URL=https://pointvpn.fstars.uz/payment/handle
# UZS per 1 RUB; plan prices are in RUB
ROUBLE_PRICE=150
